{
  "version": 1,
  "framework": "cypress",
  "cypress": {
    "configFile": "config/cypress.config.ts"
  },
  "defaultEnvironment": "staging",
  "environments": {
    "smoke": {
      "API_URL": "https://smoke.example.test",
      "RETRIES": "0"
    },
    "staging": {
      "API_URL": "https://staging.example.test",
      "RETRIES": "2"
    }
  },
  "output": {
    "reports": "results/reports",
    "evidence": "results/evidence"
  }
}