{
  "name": "qat-cli",
  "version": "0.1.0",
  "description": "CLI-first test automation engineering platform for Cypress projects: project scaffolding, diagnostics, execution, evidence collection and reporting.",
  "keywords": [
    "test-automation",
    "cypress",
    "cli",
    "testing",
    "e2e",
    "qa",
    "quality-assurance",
    "sdet",
    "test-runner",
    "qat"
  ],
  "author": "Qinis Tech",
  "license": "MIT",
  "homepage": "https://github.com/qinis-tech/qat-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinis-tech/qat-cli.git"
  },
  "bugs": {
    "url": "https://github.com/qinis-tech/qat-cli/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "bin": {
    "qat": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "adr:new": "node scripts/adr.mjs new",
    "adr:index": "node scripts/adr.mjs index",
    "adr:check": "node scripts/adr.mjs check",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run adr:check && npm test",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "execa": "^9.6.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
