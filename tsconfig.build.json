{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    "rootDir": "./src",
    "outDir": "./dist",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/dist.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "tests",
    "dist",
    "node_modules"
  ]
}