{
  // Type-checks the whole repository: src, tests, and tool configs.
  // Emit is handled exclusively by tsconfig.build.json.
  "compilerOptions": {
    // ── Environment ────────────────────────────────────────────────
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "resolveJsonModule": true,

    // ── Modules ────────────────────────────────────────────────────
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,

    // ── Path mapping ───────────────────────────────────────────────
    // Resolved relative to this file. No baseUrl: it is deprecated in
    // TypeScript 6 and stops functioning in 7.0, and paths no longer
    // requires it.
    "paths": {
      "~/*": ["./src/*"]
    },

    // ── Strictness ─────────────────────────────────────────────────
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // ── Correctness / performance ──────────────────────────────────
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // ── This configuration never emits ─────────────────────────────
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
